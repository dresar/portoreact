{
  "name": "trees",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx server.ts",
    "server:dev": "tsx watch server.ts",
    "create-user": "tsx create-user.js",
    "create-dummy-education": "tsx create-dummy-education.js",
    "start": "concurrently \"npm run server\" \"npm run dev\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\"",
    "start:dev": "concurrently \"npm run server:dev\" \"npm run dev\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\"",
    "dev:all": "concurrently \"tsx watch server.ts\" \"vite\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\""
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.66.0",
